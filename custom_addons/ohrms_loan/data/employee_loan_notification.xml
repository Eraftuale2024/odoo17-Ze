<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ohrms_loan_request_email_template_id" model="mail.template">
           <field name="name">Loan Request Request Request</field>
           <field name="model_id" ref="ohrms_loan.model_hr_loan"/>
           <field name="email_from">{{object.employee_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.parent_id.work_email}}</field>
           <field name="subject">Loan Request Request</field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.parent_id.name"/> </span></p>
               <p> <b>I hope you are well!</b></p>
               <p>I would like to request a loan of <t t-esc="object.loan_amount"/> for <t t-esc="object.purpose"/>.<br/>I am committed to repaying it according to the
                    agreed terms.
                    </p>
               <p>Thank you for considering my request.</p>
               <p>Best regards</p>
           </field>
       </record>

        <record id="ohrms_loan_approval_email_template_id" model="mail.template">
           <field name="name">Loan Request Request Approve</field>
           <field name="model_id" ref="ohrms_loan.model_hr_loan"/>
           <field name="email_from">{{object.employee_id.parent_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.work_email}}</field>
           <field name="subject">Insurance Utilization Request Approval</field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.name"/> </span></p>
               <p>I am pleased to inform you that your loan request for <t t-esc="object.loan_amount"/> has been approved.<br/> The loan will be
                    processed according to the agreed terms, and you can expect to receive the funds by <t t-esc="object.payment_date"/>.</p>
               <p>Please attach the completed documents so we can proceed with your reimbursement request.</p>
                 <p>Best regards, </p>
           </field>
       </record>

    <record id="ohrms_loan_rejected_email_template_id" model="mail.template">
           <field name="model_id" ref="ohrms_loan.model_hr_loan"/>
           <field name="email_from">{{object.employee_id.parent_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.work_email}}</field>
           <field name="subject">Insurance Utilization Request Rejection</field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.name"/> </span></p>
               <p>After careful consideration, we regret to inform you that we are unable to approve your request at this<br/>
                    time due to <t t-esc="object.rejection_reason"/>.</p>
               <p>Thank you for your understanding.</p>
               <p>Best regards, </p>
           </field>
       </record>
    </data>
</odoo>