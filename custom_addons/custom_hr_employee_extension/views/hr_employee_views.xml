<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_tin_pension"
            model="ir.ui.view">

        <field name="name">hr.employee.form.tin.pension</field>
        <field name="model">hr.employee</field>

        <field name="inherit_id"
               ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='work_phone']"
                   position="after">

                <field name="tin_no"/>
                <field name="pension_no"/>

            </xpath>

        </field>

    </record>

</odoo>