<odoo>
    <template id="hr_bank_latter_template_id">
         <t t-call="web.html_container">
        <t t-call="web.external_layout">
             <style>
                        .p {
                            font-size: 16px;
                            margin-bottom: 1px;
                        }

                        .table {
                            width: 100%;
                            border-collapse: collapse;
                        }

                        .table th, .table td {
                            border: 1px solid black;
                            text-align: left;
                            font-size: 14px;
                            margin-bottom: 1px;
                        }

                        .table thead th {
                            background-color: #f2f2f2;
                        }

                        .text-end {
                            text-align: right;
                        }

                        .page {
                            margin: 20px;
                        }
                    </style>
            <div class="page">
                 <div class="text-header">
                     <h6>Date: <span t-esc="colum['today_date']"/><br/></h6>
                    <h6>Ref: <span t-esc="colum['ref_no']"/></h6><br/>

                     <h5><b><span t-esc="colum['bank']"/></b></h5>
                     <h5><b><span t-esc="colum['branch']"/></b></h5>
                     <h5><b><span t-esc="colum['branch_location']"/></b></h5>
                     <br/><br/>

                    <p style="text-align: center;"><u><b>Subject: Request to deposit Staff Salary in their Respective Account Number at your  Branch </b></u></p><br/><br/>
                     <h6>Dear Sirs;</h6>
                    <p>Please deposit the attached <span t-esc="colum['no_pages']"/> (<span t-esc="colum['no_pages_word']"/>) Page Staff Salary Payment at your esteemed bank
                     in their respective saving account at your Branch the month of <b><span t-esc="colum['date']"/> (<span t-esc="colum['ethiopic_month']"/> <span t-esc="colum['ethiopic_year']"/>)</b>
                     amounting <b><span t-esc="round(sum(doc.net for doc in docs), 2)"/> ( <span t-esc= "colum['amount_in_word']"/> )</b>
                    </p>
                     <p>we have authorized your esteemed bank to deduct the amount and any service charge that
                     may be extended to this purpose from account number <b><span t-esc= "colum['bank_acc']"/></b> </p><br/><br/>
                     <p>We thanks you in advance for your Cooperation</p><br/><br/>
                     <p>Regards</p>


                </div>

                <div style="page-break-before: always;">
                   <div class="text-header" style="text-align: center;">
                    <h4>Ethiopia Securities Exchange</h4>

                    <h5> Payroll For the Month of <t t-esc="colum['date']"/> </h5>

                </div>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employee</th>
                            <th>Bank</th>
                            <th>Account Number</th>
                            <th>Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_index" t-value="0"/>
                        <t t-foreach="docs" t-as="doc">
                            <t t-set="line_index" t-value="line_index + 1"/>
                            <tr>
                              <td><span t-esc="line_index"/></td>
                              <td><t t-esc="doc.employee"/></td>
                              <td><t t-esc="doc.bank_account_id.bank_id.name"/></td>
                              <td><t t-esc="doc.bank_account_id.acc_number"/></td>
                              <td>
                                  <t t-esc="'{:,.2f}'.format(doc.net)"/></td>
                            </tr>
                        </t>
                        <tr>
                            <td colspan="4" >Total</td>
                            <td><span t-esc="'{:,.2f}'.format(sum(doc.net for doc in docs))"/></td>
                        </tr>
                    </tbody>
                </table>
                     </div>

            </div>

             <div class="row">
                 <div class="col-3"> <span>Prepared By:_________________  </span></div>
                 <div class="col-3"> <span>Checked By:_________________  </span></div>
                 <div class="col-3"> <span>Verified By:_________________  </span></div>
                 <div class="col-3"> <span>Approved By:_________________  </span></div>
            </div>

        </t>
    </t>
    </template>
    <record id="payroll_report_action_id_bank_latter" model="ir.actions.report">
        <field name="name">Payslip Payroll</field>
        <field name="model">custom.hr.payroll.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_hr_payroll_report.hr_bank_latter_template_id</field>
        <field name="report_file">custom_hr_payroll_report.hr_bank_latter_template_id</field>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>









