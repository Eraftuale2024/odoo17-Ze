<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Default leave increment rules.
        Based on Ethiopian Labour Proclamation No. 1156/2019, Article 61:
        14 working days base + 1 extra day per additional year of service.
        Adjust to match your organisation's policy.
    -->

    <record id="leave_increment_rule_1" model="hr.leave.increment.rule">
        <field name="name">1+ Years of Service</field>
        <field name="years_of_service">1</field>
        <field name="additional_days">1</field>
    </record>

    <record id="leave_increment_rule_2" model="hr.leave.increment.rule">
        <field name="name">2+ Years of Service</field>
        <field name="years_of_service">2</field>
