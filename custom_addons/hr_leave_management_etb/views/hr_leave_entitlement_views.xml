<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== FORM VIEW ======== -->
    <record id="hr_leave_entitlement_form_view" model="ir.ui.view">
        <field name="name">hr.leave.entitlement.form</field>
        <field name="model">hr.leave.entitlement</field>
        <field name="arch" type="xml">
            <form string="Leave Entitlement">
                <header>
                    <button name="action_recompute"
                            string="Recompute"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>

                        <!-- ── Employee Info ── -->
                        <group string="Employee Info">
                            <field name="employee_id"/>
                            <field name="year"/>
                            <field name="date_of_joining"
                                   string="Joined (from Contract)"/>
                            <field name="years_of_service"
                                   string="Years of Service (Today)"
                                   digits="[16,2]"/>
                            <field name="years_of_service_at_year"
                                   string="Years at Leave Year Start"
                                   digits="[16,2]"/>
                        </group>

                        <!-- ── Leave Entitlement ── -->
                        <group string="Leave Entitlement">
                            <field name="base_leave_days"/>
                            <field name="applicable_increment_rule_id"/>
                            <field name="increment_days"/>
                            <field name="total_entitlement"/>
                        </group>

                    </group>
                    <group>

                        <!-- ── Leave Usage ── -->
                        <group string="Leave Usage">
                            <field name="leave_days_used"/>
                            <field name="leave_days_remaining"/>
                        </group>

                        <!-- ── Monetary Value ── -->
                        <group string="Monetary Value (ETB)">
                            <field name="salary"
                                   string="Monthly Salary (ETB)"/>
                            <field name="annual_salary"
                                   string="Annual Salary (ETB)"/>
                            <field name="daily_rate"
                                   string="Daily Rate (ETB)"
                                   digits="[16,4]"/>
                            <field name="leave_monetary_value"
                                   string="Total Leave Value (ETB)"/>
                            <field name="used_leave_value"
                                   string="Used Leave Value (ETB)"/>
                            <field name="remaining_leave_value"
                                   string="Remaining Leave Value (ETB)"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======== TREE VIEW ======== -->
    <record id="hr_leave_entitlement_list_view" model="ir.ui.view">
        <field name="name">hr.leave.entitlement.list</field>
        <field name="model">hr.leave.entitlement</field>
        <field name="arch" type="xml">
            <tree string="Leave Entitlements"
                  decoration-danger="leave_days_remaining &lt; 0"
                  decoration-success="leave_days_remaining &gt; 0">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="date_of_joining" string="Joined"/>
                <field name="years_of_service" string="Service (Today)" digits="[16,2]"/>
                <field name="years_of_service_at_year" string="Service (At Year)" digits="[16,2]"/>
                <field name="base_leave_days" string="Base Days"/>
                <field name="increment_days" string="Increment"/>
                <field name="total_entitlement" string="Total Days"/>
                <field name="leave_days_used" string="Used"/>
                <field name="leave_days_remaining" string="Remaining"/>
                <field name="daily_rate" string="Daily Rate (ETB)" digits="[16,4]"/>
                <field name="leave_monetary_value" string="Full Value (ETB)"/>
                <field name="remaining_leave_value" string="Remaining Value (ETB)"/>
            </tree>
        </field>
    </record>

    <!-- ======== SEARCH VIEW ======== -->
    <record id="hr_leave_entitlement_search_view" model="ir.ui.view">
        <field name="name">hr.leave.entitlement.search</field>
        <field name="model">hr.leave.entitlement</field>
        <field name="arch" type="xml">
            <search string="Search Leave Entitlements">
                <field name="employee_id"/>
                <field name="year"/>
                <filter string="Current Year"
                        name="current_year"
                        domain="[('year', '=', context_today().year)]"/>
                <filter string="Low Remaining"
                        name="low_remaining"
                        domain="[('leave_days_remaining', '&lt;', 5)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Year" name="group_year"
                            context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======== ACTION ======== -->
    <record id="action_hr_leave_entitlement" model="ir.actions.act_window">
        <field name="name">Leave Entitlements</field>
        <field name="res_model">hr.leave.entitlement</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_leave_entitlement_search_view"/>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leave entitlements found.
            </p>
            <p>Create entitlement records for employees to track annual leave.</p>
        </field>
    </record>

</odoo>